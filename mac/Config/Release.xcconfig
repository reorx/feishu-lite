// 发布版使用用户安装的后端，绝不烘入构建机源码路径。
FEISHU_BACKEND_DIR =
FEISHU_UV_PATH =
FEISHU_BACKEND_REVISION = master

// Release 必须 Developer ID 签名 + notarytool 公证。
// DEVELOPMENT_TEAM 由发布脚本通过 xcodebuild 参数覆盖，不读取 Debug 的 Local.xcconfig。
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
OTHER_CODE_SIGN_FLAGS = --timestamp
// xcodebuild build 默认注入调试权限；Developer ID 公证禁止 get-task-allow。
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
